{
  "name": "multi-automl-desktop",
  "version": "5.0.1",
  "description": "Multi-AutoML Interface - Desktop Application",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win --publish never",
    "build-mac": "electron-builder --mac --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "dev": "concurrently \"npm run streamlit\" \"wait-on http://localhost:8501 && electron .\"",
    "streamlit": "streamlit run app.py --server.port 8501",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "automl",
    "machine-learning",
    "desktop-app",
    "electron",
    "streamlit"
  ],
  "author": "Pedro Morato Lahoz",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "joi": "^17.13.8",
    "shell-quote": "^1.10.0"
  },
  "build": {
    "appId": "com.multi-automl.desktop",
    "productName": "Multi-AutoML Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "app.py",
      "requirements.txt",
      "package.json",
      "error_loading.html"
    ],
    "extraResources": [
      {
        "from": "src/",
        "to": "src/"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": false
  }
}
